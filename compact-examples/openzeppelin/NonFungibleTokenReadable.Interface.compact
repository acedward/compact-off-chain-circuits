// SPDX-License-Identifier: Apache-2.0
// compact-off-chain-circuits — published interface (partial source) for a contract
// built on `NonFungibleTokenReadable`.
//
// THE TWO INVARIANTS
//
// 1. LEDGER LAYOUT. A verifier key is a function of ledger slot positions, slot
//    types and circuit logic; identifiers of every kind are erased by the
//    compiler. This file therefore declares NO ledger of its own and imports the
//    SAME module the deployed contract imports, which reproduces the deployed
//    slot order exactly. If you write an interface by hand instead, repeat every
//    ledger declaration of the full contract in the original order and with the
//    original types; you may rename them. A declaration inserted BEFORE a slot a
//    published circuit reads shifts that slot and changes the key.
//
// 2. ENTRY POINT NAMES. The chain stores each verifier key under the entry point
//    name the deployed contract exported. Consumers look keys up by that name, so
//    every circuit exported here MUST keep the deployed contract's name, even
//    though the key itself does not depend on it.
//
// Exposed here: name, symbol, tokenURI, ownerOf, balanceOf.
// Everything else the deployed contract can do stays unpublished; its entry point
// names and verifier keys remain visible on chain, its circuit bodies do not.

pragma language_version >= 0.23.0;

import CompactStandardLibrary;
import "./NonFungibleTokenReadable" prefix NonFungibleTokenReadable_;

export { ContractAddress, Either, Maybe };

export circuit name(): Opaque<"string"> {
  return NonFungibleTokenReadable_name();
}

export circuit symbol(): Opaque<"string"> {
  return NonFungibleTokenReadable_symbol();
}

export circuit tokenURI(tokenId: Uint<128>): Opaque<"string"> {
  return NonFungibleTokenReadable_tokenURI(tokenId);
}

export circuit ownerOf(tokenId: Uint<128>): Either<Bytes<32>, ContractAddress> {
  return NonFungibleTokenReadable_ownerOf(tokenId);
}

export circuit balanceOf(account: Either<Bytes<32>, ContractAddress>): Uint<128> {
  return NonFungibleTokenReadable_balanceOf(account);
}
