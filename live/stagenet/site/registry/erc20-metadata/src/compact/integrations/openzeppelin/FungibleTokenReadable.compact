// SPDX-License-Identifier: Apache-2.0
// compact-off-chain-circuits — OpenZeppelin FungibleToken integration.
//
// Composition, not a fork: the upstream module under `compact/vendor/openzeppelin/`
// is imported verbatim and every one of its exported circuits is re-exported here
// unchanged, so upstream updates stay drop-in. The only addition is
// `publishBundle`, from the pattern module `compact/OffChainInterface.compact`.
//
// A contract that imports THIS module instead of the upstream one gains the
// ability to commit to an off-chain interface bundle, and keeps the upstream
// ledger layout: this module declares no ledger of its own, so the slots are
// exactly the upstream module's, in the upstream declaration order. That is the
// invariant that makes `FungibleTokenReadable.Interface.compact` produce
// verifier keys byte-identical to the deployed contract's.
//
// Upstream: OpenZeppelin compact-contracts v0.3.0-alpha.1 @ 746724f8, MIT,
// (c) 2025 Zeppelin Group Ltd — see NOTICE.

pragma language_version >= 0.23.0;

module FungibleTokenReadable {
  import CompactStandardLibrary;
  import "../../vendor/openzeppelin/token/FungibleToken" prefix FungibleToken_;
  import "../../OffChainInterface" prefix OffChainInterface_;

  /**
   * @description Commits this contract to an off-chain interface bundle.
   * @param {Bytes<256>} payload - commitment (32 bytes) ++ utf8(index.json url) zero padded.
   * @return {[]} - Empty tuple.
   */
  export circuit publishBundle(payload: Bytes<256>): [] {
    return OffChainInterface_publishBundle(payload);
  }

  // ---------------------------------------------------------------------------
  // Upstream FungibleToken exports, re-exported verbatim (19 circuits).
  // ---------------------------------------------------------------------------

  export circuit initialize(name_: Opaque<"string">, symbol_: Opaque<"string">, decimals_: Uint<8>): [] {
    return FungibleToken_initialize(name_, symbol_, decimals_);
  }

  export circuit name(): Opaque<"string"> {
    return FungibleToken_name();
  }

  export circuit symbol(): Opaque<"string"> {
    return FungibleToken_symbol();
  }

  export circuit decimals(): Uint<8> {
    return FungibleToken_decimals();
  }

  export circuit totalSupply(): Uint<128> {
    return FungibleToken_totalSupply();
  }

  export circuit balanceOf(account: Either<Bytes<32>, ContractAddress>): Uint<128> {
    return FungibleToken_balanceOf(account);
  }

  export circuit transfer(to: Either<Bytes<32>, ContractAddress>, value: Uint<128>): Boolean {
    return FungibleToken_transfer(to, value);
  }

  export circuit _unsafeTransfer(to: Either<Bytes<32>, ContractAddress>, value: Uint<128>): Boolean {
    return FungibleToken__unsafeTransfer(to, value);
  }

  export circuit allowance(owner: Either<Bytes<32>, ContractAddress>, spender: Either<Bytes<32>, ContractAddress>): Uint<128> {
    return FungibleToken_allowance(owner, spender);
  }

  export circuit approve(spender: Either<Bytes<32>, ContractAddress>, value: Uint<128>): Boolean {
    return FungibleToken_approve(spender, value);
  }

  export circuit transferFrom(fromAddress: Either<Bytes<32>, ContractAddress>, to: Either<Bytes<32>, ContractAddress>, value: Uint<128>): Boolean {
    return FungibleToken_transferFrom(fromAddress, to, value);
  }

  export circuit _unsafeTransferFrom(fromAddress: Either<Bytes<32>, ContractAddress>, to: Either<Bytes<32>, ContractAddress>, value: Uint<128>): Boolean {
    return FungibleToken__unsafeTransferFrom(fromAddress, to, value);
  }

  export circuit _transfer(fromAddress: Either<Bytes<32>, ContractAddress>, to: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
    return FungibleToken__transfer(fromAddress, to, value);
  }

  export circuit _unsafeUncheckedTransfer(fromAddress: Either<Bytes<32>, ContractAddress>, to: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
    return FungibleToken__unsafeUncheckedTransfer(fromAddress, to, value);
  }

  export circuit _mint(account: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
    return FungibleToken__mint(account, value);
  }

  export circuit _unsafeMint(account: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
    return FungibleToken__unsafeMint(account, value);
  }

  export circuit _burn(account: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
    return FungibleToken__burn(account, value);
  }

  export circuit _approve(owner: Either<Bytes<32>, ContractAddress>, spender: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
    return FungibleToken__approve(owner, spender, value);
  }

  export circuit _spendAllowance(owner: Either<Bytes<32>, ContractAddress>, spender: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
    return FungibleToken__spendAllowance(owner, spender, value);
  }
}
