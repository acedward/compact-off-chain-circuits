// SPDX-License-Identifier: Apache-2.0
// Live demonstration of the end-of-ledger interface registry (placement P4).
//
// Same module and same six reads as ERC20Live, so the read circuits compile to the
// keys the repository's tests check. Two contract-level fields follow the module's
// seven: `publisher`, then `__interfaces` declared LAST, so the registry is always
// the ledger's last leaf and a reader can find it without knowing the layout.
// Contract fields never shift module fields, so adding the registry leaves every
// read circuit's verifier key unchanged.
//
// Only the holder of the publisher secret may write the registry: the constructor
// stores a hash of it and publishInterface checks it through a witness.
pragma language_version >= 0.23.0;

import CompactStandardLibrary;
import "../../../compact/integrations/openzeppelin/FungibleTokenReadable" prefix FungibleToken_;

export { ContractAddress, Either, Maybe };

export struct InterfaceRef { commitment: Bytes<32>; url: Opaque<"string">; }

witness publisherSecret(): Bytes<32>;

constructor(
  _name: Opaque<"string">,
  _symbol: Opaque<"string">,
  _decimals: Uint<8>,
  holder: Either<Bytes<32>, ContractAddress>,
  supply: Uint<128>,
  publisherCommitment: Bytes<32>
) {
  FungibleToken_initialize(_name, _symbol, _decimals);
  FungibleToken__mint(disclose(holder), disclose(supply));
  publisher = disclose(publisherCommitment);
}

export circuit name(): Opaque<"string"> { return FungibleToken_name(); }
export circuit symbol(): Opaque<"string"> { return FungibleToken_symbol(); }
export circuit decimals(): Uint<8> { return FungibleToken_decimals(); }
export circuit totalSupply(): Uint<128> { return FungibleToken_totalSupply(); }
export circuit balanceOf(account: Either<Bytes<32>, ContractAddress>): Uint<128> { return FungibleToken_balanceOf(account); }
export circuit allowance(owner: Either<Bytes<32>, ContractAddress>, spender: Either<Bytes<32>, ContractAddress>): Uint<128> {
  return FungibleToken_allowance(owner, spender);
}

export ledger publisher: Bytes<32>;

export circuit publishInterface(standard: Bytes<32>, commitment: Bytes<32>, url: Opaque<"string">): [] {
  assert(persistentHash<Vector<2, Bytes<32>>>([pad(32, "coc:publisher:"), publisherSecret()]) == publisher,
         "only the publisher can publish an interface");
  __interfaces.insert(disclose(standard), InterfaceRef { commitment: disclose(commitment), url: disclose(url) });
}

// The registry. Keep this the LAST ledger declaration of the contract.
export ledger __interfaces: Map<Bytes<32>, InterfaceRef>;
