// SPDX-License-Identifier: Apache-2.0
// compact-off-chain-circuits — the pattern module.
//
// This is the ONLY contract code the pattern adds to a contract: one circuit that
// emits the contract's commitment to its off-chain interface bundle.
//
// The payload is assembled by the caller, because Compact has no byte
// concatenation:
//
//     payload[0..32)   = the bundle commitment (JubJub multiset hash of its index)
//     payload[32..256) = utf8 of the index.json URL, zero padded (URL <= 224 bytes)
//
// The circuit is impure (it emits), so the chain stores a verifier key for it
// under the entry point name the including contract exports it as. Calling it
// costs one transaction with one proof, once per published bundle version.
//
// This file is self-contained: it imports nothing from this repository and can be
// copied into any Compact project on its own.

pragma language_version >= 0.23.0;

module OffChainInterface {
  import CompactStandardLibrary;

  /**
   * @description Commits the contract to an off-chain interface bundle.
   * @param {Bytes<256>} payload - commitment (32 bytes) ++ utf8(index.json url) zero padded to 224 bytes.
   * @return {[]} - Empty tuple.
   */
  export circuit publishBundle(payload: Bytes<256>): [] {
    emit(Misc { name: pad(32, "bundle/v1"), payload: disclose(payload) });
  }
}
