// contracts/src/token/test/mocks/MockFungibleToken.compact, (c) 2025 Zeppelin Group Ltd.
//
// WARNING: FOR TESTING PURPOSES ONLY. Like the upstream mock, this contract
// exposes internal circuits and bypasses safety checks. DO NOT deploy it.
//
// Placement P3, the interface registry at the START of the ledger: the
// fungible example (compact/examples/fungible/Full.compact) with
// `compact/registry/InterfaceRegistry` imported FIRST, so its map is ledger
// field 0 and the state's first leaf. Every FungibleToken field moves up by
// one, so the read circuits get different verifier keys than in the fungible
// example; the published interface is `Interface.compact` next to this file,
// which imports the same two modules in the same order.
//
// Also exports placement P1 (`publishInterfaceEvent`, one Misc event per
// standard) and keeps P0 (`publishBundle`). Neither reads the ledger, so both
// keep the keys they have in every other contract.
//
// Changes from the fungible example (4): the registry import first, the
// events import, and the three wrappers below `publishBundle`. No access
// control; see the header of InterfaceRegistry.compact.

pragma language_version >= 0.23.0;

import CompactStandardLibrary;

import "../../registry/InterfaceRegistry" prefix InterfaceRegistry_;   // FIRST: field 0
import "../../integrations/openzeppelin/FungibleTokenReadable" prefix FungibleToken_;
import "../../registry/InterfaceEvents" prefix InterfaceEvents_;       // no ledger: position irrelevant

export { ContractAddress, Either, Maybe };

/**
 * @description `init` is a param for testing.
 * If `init` is true, initialize the contract with the
 * _name`, `_symbol`, and `_decimals`.
 * Otherwise, the contract will not initialize and we can test
 * the contract when it is not initialized properly.
*/
constructor(
  _name: Opaque<"string">,
  _symbol: Opaque<"string">,
  _decimals:Uint<8>,
  init: Boolean
) {
  if (disclose(init)) {
    FungibleToken_initialize(_name, _symbol, _decimals);
  }
}


export circuit publishBundle(payload: Bytes<256>): [] {
  return FungibleToken_publishBundle(payload);
}

export circuit publishInterface(standard: Bytes<32>, commitment: Bytes<32>, url: Opaque<"string">): [] {
  return InterfaceRegistry_publishInterface(standard, commitment, url);
}

export circuit removeInterface(standard: Bytes<32>): [] {
  return InterfaceRegistry_removeInterface(standard);
}

export circuit publishInterfaceEvent(name: Bytes<32>, payload: Bytes<256>): [] {
  return InterfaceEvents_publishInterfaceEvent(name, payload);
}

export circuit name(): Opaque<"string"> {
  return FungibleToken_name();
}

export circuit symbol(): Opaque<"string"> {
  return FungibleToken_symbol();
}

export circuit decimals(): Uint<8> {
  return FungibleToken_decimals();
}

export circuit totalSupply(): Uint<128> {
  return FungibleToken_totalSupply();
}

export circuit balanceOf(account: Either<Bytes<32>, ContractAddress>): Uint<128> {
  return FungibleToken_balanceOf(account);
}

export circuit allowance(
  owner: Either<Bytes<32>, ContractAddress>,
  spender: Either<Bytes<32>, ContractAddress>
): Uint<128> {
  return FungibleToken_allowance(owner, spender);
}

export circuit transfer(to: Either<Bytes<32>, ContractAddress>, value: Uint<128>): Boolean {
  return FungibleToken_transfer(to, value);
}

export circuit _unsafeTransfer(to: Either<Bytes<32>, ContractAddress>, value: Uint<128>): Boolean {
  return FungibleToken__unsafeTransfer(to, value);
}

export circuit transferFrom(
  fromAddress: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  return FungibleToken_transferFrom(fromAddress, to, value);
}

export circuit _unsafeTransferFrom(
  fromAddress: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  return FungibleToken__unsafeTransferFrom(fromAddress, to, value);
}

export circuit approve(spender: Either<Bytes<32>, ContractAddress>, value: Uint<128>): Boolean {
  return FungibleToken_approve(spender, value);
}

export circuit _approve(
  owner: Either<Bytes<32>, ContractAddress>,
  spender: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  return FungibleToken__approve(owner, spender, value);
}

export circuit _transfer(
  fromAddress: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  return FungibleToken__transfer(fromAddress, to, value);
}

export circuit _unsafeUncheckedTransfer(
  fromAddress: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  return FungibleToken__unsafeUncheckedTransfer(fromAddress, to, value);
}

export circuit _mint(
  account: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  return FungibleToken__mint(account, value);
}

export circuit _unsafeMint(
  account: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  return FungibleToken__unsafeMint(account, value);
}

export circuit _burn(
  account: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  return FungibleToken__burn(account, value);
}

export circuit _spendAllowance(
  owner: Either<Bytes<32>, ContractAddress>,
  spender: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  return FungibleToken__spendAllowance(owner, spender, value);
}

